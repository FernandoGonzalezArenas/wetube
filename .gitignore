# Documentación o archivos innecesarios
HELP.md

# Archivos compilados y generados por Maven/Gradle
**/target/
build/
!.mvn/wrapper/maven-wrapper.jar

# Spring Boot (STS)
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# Maven Wrapper (opcionalmente puedes incluirlo en Git)
mvnw
mvnw.cmd
.mvn/

# Gradle (si usas Gradle en lugar de Maven)
.gradle/
gradle-app.setting

# Logs y archivos temporales
logs/
log/
*.log

# Configuraciones del sistema operativo
.DS_Store
Thumbs.db

# Evitar que recursos de `src/main/resources` sean ignorados accidentalmente
!src/main/resources/static/
!src/main/resources/templates/
!application.properties
!application.yml

# --- SECCIÓN DE MULTIMEDIA Y ARCHIVOS PESADOS ---
**/test-data/
*.mp4
*.mkv
*.avi
*.mov
*.jpg
*.png

# EXCEPCIONES: Permitir imágenes necesarias para la UI del frontend
!**/frontend/public/**/*.png
!**/frontend/public/**/*.jpg
!**/frontend/public/**/*.svg
!**/frontend/public/**/*.ico

# --- SECCIÓN DE DOCUMENTOS Y TEXTO ---
**/*.txt
**/*.http
**/.editorconfig

# EXCEPCIÓN: Permitir archivos de configuración específicos
!**/frontend/public/robots.txt
!**/frontend/public/manifest.json
!HELP.md

# --- CREDENCIALES ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- NEXT.JS / FRONTEND (wetube/frontend/) ---

# Dependencias (Evita subir miles de archivos de node)
**/frontend/node_modules/

# Compilación de Next.js
**/frontend/.next/
**/frontend/out/
**/frontend/build/

# Logs de npm/yarn
**/frontend/npm-debug.log*
**/frontend/yarn-debug.log*
**/frontend/yarn-error.log*

# Variables de entorno locales (SEGURIDAD)
**/frontend/.env*.local
**/frontend/.env

# Caché de herramientas
**/frontend/.eslintcache
**/frontend/.next/cache/