# =========================================================================
# teakter-backend - .gitignore oficial para el repositorio de Backend
# =========================================================================

# Documentación del framework
HELP.md

# Archivos compilados y generados por Maven / Gradle
**/target/
build/
!.mvn/wrapper/maven-wrapper.jar

# Archivos de configuración de IDEs (IntelliJ IDEA, Eclipse, NetBeans)
.idea/
*.iws
*.iml
*.ipr
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# Maven Wrapper y Gradle
mvnw
mvnw.cmd
.mvn/
.gradle/
gradle-app.setting

# Logs y archivos temporales del sistema
logs/
log/
*.log
.DS_Store
Thumbs.db

# =========================================================================
# CONFIGURACIÓN DE RECURSOS DE SPRING BOOT / PYTHON
# =========================================================================

# Asegurar que los recursos esenciales de Java no se ignoren
!src/main/resources/static/
!src/main/resources/templates/
!application.properties
!application.yml

# --- SECCIÓN DE MULTIMEDIA Y ARCHIVOS PESADOS ---
# Bloquea archivos de video pesados en cualquier subcarpeta (como test-data)
**/test-data/
*.mp4
*.mkv
*.avi
*.mov

# Permitir imágenes de configuración del sistema pero ignorar fotos sueltas
# (Ideal si usas almacenamiento local temporal en desarrollo)
*.jpg
*.png

# --- SECCIÓN DE DOCUMENTOS Y TEXTO ---
**/*.txt
**/*.http
**/.editorconfig

# --- VARIABLES DE ENTORNO Y CREDENCIALES (CRÍTICO POR SEGURIDAD) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local